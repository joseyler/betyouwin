FROM node:20-alpine AS builder

WORKDIR /app/byw-web

ARG NEXT_PUBLIC_API_URL=http://localhost:3000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

COPY byw-web/package.json byw-web/package-lock.json ./
RUN npm install

COPY byw-web/ ./
RUN npm run build

FROM node:20-alpine

WORKDIR /app/byw-web

COPY byw-web/package.json byw-web/package-lock.json ./
RUN npm install --omit=dev

COPY --from=builder /app/byw-web/.next ./.next
COPY --from=builder /app/byw-web/public ./public
COPY --from=builder /app/byw-web/next.config.ts ./

ENV NODE_ENV=production
EXPOSE 3001

CMD ["npm", "run", "start", "--", "-H", "0.0.0.0", "-p", "3001"]
