# Copiar a docker/.env antes de: docker compose --env-file docker/.env up --build

# MySQL
MYSQL_ROOT_PASSWORD=betyouwin_dev
MYSQL_DATABASE=betyouwin
# Puerto en el host (3307 si ya tenes MySQL local en 3306)
MYSQL_PORT=3307

# Puertos expuestos al host
PORT_API=3000
PORT_WEB=3001

# byw-api / byw-web — URLs de la red interna Docker (contenedor qa)
# Para Playwright en el host, usar en su lugar:
#   CORS_ORIGIN=http://localhost:3001
#   NEXT_PUBLIC_API_URL=http://localhost:3000
CORS_ORIGIN=http://web:3001
NEXT_PUBLIC_API_URL=http://api:3000

JWT_SECRET=docker-dev-change-me
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@betyouwin.com

# Contenedor qa (profile test)
QA_WEB_URL=http://web:3001
QA_API_URL=http://api:3000
QA_NPM_SCRIPT=test:registro
